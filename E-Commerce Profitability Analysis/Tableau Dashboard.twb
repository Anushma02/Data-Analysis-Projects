      <aliases enabled='yes' />
      <column caption='Average Profit per Order with Platform Fee' datatype='real' name='[Calculation_0159716611510272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit])/COUNT([order_id])' />
      </column>
      <column caption='Average Profit per Order without Platform Fee' datatype='real' name='[Calculation_0159716611760129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([profit])+SUM([platform_fee]))/COUNT([order_id])' />
      </column>
      <column caption='Return Rate' datatype='real' default-format='p0.00%' name='[Calculation_0159716620984323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [returned] = &apos;Yes&apos; THEN 1 ELSE 0 END)/COUNT([order_id])' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_1747685675327492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([net_revenue])' />
      </column>
      <column caption='Product Cost %' datatype='real' default-format='p0.00%' name='[Calculation_1747685680041989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([product_cost]) / SUM([gross_revenue])' />
      </column>
      <column caption='Shipping Cost %' datatype='real' default-format='p0.00%' name='[Calculation_1747685680660486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shipping_cost]) / SUM([gross_revenue])' />
      </column>
      <column caption='Discount Amount %' datatype='real' default-format='p0.00%' name='[Calculation_1747685681111047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount]) / SUM([gross_revenue])' />
      </column>
      <column caption='Refund Amount %' datatype='real' default-format='p0.00%' name='[Calculation_1747685681315848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([refund_amount]) / SUM([gross_revenue])' />
      </column>
