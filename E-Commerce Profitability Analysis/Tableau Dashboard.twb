    <dashboard name='Story 1' type='storyboard'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98224' id='1' param='vert' removable='false' type-v2='layout-flow' w='99002' x='499' y='888'>
            <zone h='5549' id='3' type-v2='title' w='99002' x='499' y='888' />
            <zone h='11210' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99002' x='499' y='6437' />
            <zone h='81465' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99002' x='499' y='17647'>
              <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Title' captured-sheet='' id='6' />
                  <story-point caption='Category Profitability' captured-sheet='Q1 Dashboard' id='1' />
                  <story-point caption='Channel Analysis' captured-sheet='Q2 Dashboard' id='2' />
                  <story-point caption='Returns Analysis' captured-sheet='Q3 Dashboard' id='3' />
                  <story-point caption='Marketing ROAS' captured-sheet='Q4 Dashboard' id='4' />
                  <story-point caption='Budget Cut Recommendation' captured-sheet='Q5 Dashboard' id='5' />
                  <story-point caption='Summary' captured-sheet='' id='7' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='37847' id='6' story-point-id='6' type-v2='text' w='58229' x='21384' y='30300'>
          <formatted-text>
            <run bold='true' fontcolor='#000000'>BrightCart E-Commerce Profitability Analaysis | FY2024-2026 | Analysing Profitability Across 2000 Orders, 8 Product Categories, 4 Sales Channels, and 6 Marketing Platforms to Identify Where BrightCart is Making and Losing Money.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='76249' hidden='true' id='7' story-point-id='7' type-v2='text' w='94514' x='2681' y='20311'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000'>Summary &amp; Recommendations:</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>1. Reduce Shipping Costs in the Books Category</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Books have the lowest profit margin (11.94%) due to having the highest shipping costs (29.94%).</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Negotiate better shipping rates with courier for books.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Introduce minimum order value for free shipping on books.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Explore digital alternatives like ebooks.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>2. Migrate Customers Away from Marketplace and Social Commerce to Owned Channels (Website and App)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Marketplace and Social Commerce deliver about 28% less profit margins than Mobile App and Website, due to platform fees.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Offer exclusive discounts or a loyalty programme for customers who purchase through the Mobile App or Website directly.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>3. Reallocate Marketing Budget from Email Marketing to Tiktok Ads and Influencers</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Email Marketing has the lowest ROAS at 5.41, barely clearing the 4.19 minimum viable threshold.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>- Cutting Email Marketing would save BrightCart $24,500 annually with minimal revenue impact.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{A547A8B6-76C7-4783-B06F-21E45C5E9F19}' />
    </dashboard>
  </dashboards>
