      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Average Profit Margin by Product Category</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders' name='federated.0rp9psf0woarpr1fpeu4b04x775g' />
          </datasources>
          <datasource-dependencies datasource='federated.0rp9psf0woarpr1fpeu4b04x775g'>
            <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_1747685675327492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([profit]) / SUM([net_revenue])' />
            </column>
            <column caption='Net Revenue' datatype='real' name='[net_revenue]' role='measure' type='quantitative' />
            <column-instance column='[primary_category]' derivation='None' name='[none:primary_category:nk]' pivot='key' type='nominal' />
            <column caption='Primary Category' datatype='string' name='[primary_category]' role='dimension' type='nominal' />
